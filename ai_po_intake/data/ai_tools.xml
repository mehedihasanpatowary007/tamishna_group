<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Odoo 19 native AI Tool (Documents context).
        Important: Odoo 19 marks tools with use_in_ai=True. The generic `usage`
        selection must stay at its normal server-action value.

        AI Schema is intentionally configured from the UI because its storage model
        is an Enterprise implementation detail that has changed across 19.x builds.
        See docs/SETUP_BN.md. Only one argument is required: payload_json.
    -->
    <record id="ai_tool_create_po_preview_from_document" model="ir.actions.server">
        <field name="name">PO Intake: Create Review Preview (Document)</field>
        <field name="model_id" ref="documents.model_documents_document"/>
        <field name="state">code</field>
        <field name="use_in_ai" eval="True"/>
        <field name="code"><![CDATA[
payload = payload_json if 'payload_json' in dir() else '{}'
ai['result'] = env['ai.purchase.intake'].ai_create_preview_from_payload(
    payload_json=payload,
    source_document_id=record.id,
    document_name=record.name,
)
        ]]></field>
    </record>

    <!-- Agent/topic tool. The user/agent extracts the uploaded document and supplies one JSON payload. -->
    <record id="ai_tool_create_po_preview_from_agent" model="ir.actions.server">
        <field name="name">PO Intake: Create Review Preview (Agent)</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="state">code</field>
        <field name="use_in_ai" eval="True"/>
        <field name="code"><![CDATA[
payload = payload_json if 'payload_json' in dir() else '{}'
ai['result'] = env['ai.purchase.intake'].ai_create_preview_from_payload(
    payload_json=payload,
)
        ]]></field>
    </record>
</odoo>
