<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_purchase_intake_search" model="ir.ui.view">
        <field name="name">ai.purchase.intake.search</field>
        <field name="model">ai.purchase.intake</field>
        <field name="arch" type="xml">
            <search string="Purchase Document Previews">
                <field name="name"/>
                <field name="document_name"/>
                <field name="partner_id"/>
                <field name="vendor_reference"/>
                <field name="ai_provider_used"/>
                <filter name="queued" string="Queued" domain="[('state', '=', 'queued')]"/>
                <filter name="processing" string="Processing" domain="[('state', '=', 'processing')]"/>
                <filter name="review" string="Waiting Review" domain="[('state', '=', 'review')]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="created" string="RFQ Created" domain="[('state', '=', 'created')]"/>
                <filter name="attention" string="Needs Attention" domain="[('state', '=', 'error')]"/>
                <separator/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_vendor" string="Vendor" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_provider" string="Provider" context="{'group_by': 'ai_provider_used'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_ai_purchase_intake_kanban" model="ir.ui.view">
        <field name="name">ai.purchase.intake.kanban</field>
        <field name="model">ai.purchase.intake</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile pdi_kanban_view" default_group_by="state" records_draggable="false" group_create="false" quick_create="false">
                <field name="name"/>
                <field name="document_name"/>
                <field name="partner_id"/>
                <field name="vendor_reference"/>
                <field name="order_date"/>
                <field name="total_amount"/>
                <field name="currency_id"/>
                <field name="state"/>
                <field name="line_count"/>
                <field name="matched_line_count"/>
                <field name="unmatched_line_count"/>
                <field name="source_format"/>
                <field name="ai_provider_used"/>
                <field name="purchase_order_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click pdi_kanban_card">
                            <div class="pdi_kanban_card_top">
                                <div>
                                    <div class="pdi_kicker">Preview</div>
                                    <div class="pdi_card_title"><field name="name"/></div>
                                </div>
                                <field name="state" widget="badge"/>
                            </div>

                            <div class="pdi_vendor_block">
                                <div class="pdi_vendor_name"><field name="partner_id"/></div>
                                <t t-if="record.vendor_reference.raw_value">
                                    <div class="text-muted">Ref: <field name="vendor_reference"/></div>
                                </t>
                                <t t-if="record.document_name.raw_value">
                                    <div class="text-muted"><field name="document_name"/></div>
                                </t>
                            </div>

                            <div class="pdi_metrics_row">
                                <div class="pdi_metric_box">
                                    <span class="pdi_metric_label">Total</span>
                                    <span class="pdi_metric_value"><field name="total_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/></span>
                                </div>
                                <div class="pdi_metric_box">
                                    <span class="pdi_metric_label">Lines</span>
                                    <span class="pdi_metric_value"><field name="line_count"/></span>
                                </div>
                                <div class="pdi_metric_box">
                                    <span class="pdi_metric_label">Matched</span>
                                    <span class="pdi_metric_value"><field name="matched_line_count"/></span>
                                </div>
                                <div class="pdi_metric_box pdi_metric_box_warning">
                                    <span class="pdi_metric_label">Unmatched</span>
                                    <span class="pdi_metric_value"><field name="unmatched_line_count"/></span>
                                </div>
                            </div>

                            <div class="pdi_meta_row">
                                <t t-if="record.source_format.raw_value"><span>Format: <field name="source_format"/></span></t>
                                <t t-if="record.ai_provider_used.raw_value"><span>Provider: <field name="ai_provider_used"/></span></t>
                            </div>

                            <t t-if="record.purchase_order_id.raw_value">
                                <div class="pdi_footer_hint">RFQ / PO linked</div>
                            </t>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_ai_purchase_intake_list" model="ir.ui.view">
        <field name="name">ai.purchase.intake.list</field>
        <field name="model">ai.purchase.intake</field>
        <field name="arch" type="xml">
            <list string="Purchase Document Previews" decoration-warning="state == 'error'" decoration-success="state == 'created'">
                <field name="name"/>
                <field name="document_name" optional="show"/>
                <field name="partner_id"/>
                <field name="vendor_reference" optional="show"/>
                <field name="order_date" optional="show"/>
                <field name="line_count" optional="show"/>
                <field name="matched_line_count" optional="show"/>
                <field name="unmatched_line_count" optional="show"/>
                <field name="total_amount" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="ai_provider_used" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_ai_purchase_intake_form" model="ir.ui.view">
        <field name="name">ai.purchase.intake.form</field>
        <field name="model">ai.purchase.intake</field>
        <field name="arch" type="xml">
            <form string="Purchase Document Preview">
                <header>
                    <button name="action_analyze_uploaded_document"
                            type="object"
                            string="Analyze Document"
                            class="btn-primary"
                            invisible="not source_file or purchase_order_id or state in ['queued', 'processing']"/>
                    <button name="action_process_now"
                            type="object"
                            string="Retry Processing"
                            class="btn-secondary"
                            invisible="state != 'error' or purchase_order_id"/>
                    <button name="action_create_purchase_order"
                            type="object"
                            string="Confirm &amp; Create RFQ"
                            class="btn-primary"
                            data-hotkey="q"
                            invisible="state != 'review' or purchase_order_id or has_unresolved_blockers"/>
                    <button name="action_open_purchase_order"
                            type="object"
                            string="Open RFQ / PO"
                            class="btn-secondary"
                            invisible="not purchase_order_id"/>
                    <button name="action_reset_to_review"
                            type="object"
                            string="Reset to Review"
                            invisible="state not in ['cancelled', 'error'] or purchase_order_id"/>
                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            invisible="state in ['created', 'cancelled'] or purchase_order_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,queued,processing,review,error,created,cancelled"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Processed" bg_color="text-bg-info" invisible="not extracted_by_ai"/>

                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button"
                                type="object"
                                name="action_open_purchase_order"
                                icon="fa-shopping-cart"
                                invisible="not purchase_order_id">
                            <field name="purchase_order_id" widget="statinfo" string="RFQ / PO"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <div class="alert alert-info" role="alert" invisible="state not in ['queued', 'processing']">
                        This document is in the automatic FIFO processing queue. Earlier uploads are processed first.
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="not has_unresolved_blockers">
                        <strong>RFQ creation is blocked.</strong>
                        There are <field name="blocking_exception_count" class="oe_inline" readonly="1"/> unresolved blocking exception(s).
                        Open the <strong>Exceptions</strong> tab, correct the issue where required, enter a resolution, and acknowledge each block.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="warning_exception_count == 0">
                        <strong>Review warning.</strong>
                        There are <field name="warning_exception_count" class="oe_inline" readonly="1"/> warning(s). Warnings do not block <strong>Confirm &amp; Create RFQ</strong>.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not extraction_error">
                        <field name="extraction_error" nolabel="1" readonly="1"/>
                    </div>

                    <group>
                        <group string="Source Document">
                            <field name="document_name" readonly="state == 'created'"/>
                            <field name="source_document_id" readonly="1" options="{'no_create': True}"/>
                            <field name="source_file" filename="source_filename" readonly="state == 'created'"/>
                            <field name="source_format" readonly="1" invisible="not source_format"/>
                            <field name="source_filename" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state == 'created'"/>
                        </group>
                        <group string="Purchase Header">
                            <field name="partner_id" readonly="state == 'created'"/>
                            <field name="vendor_reference" readonly="state == 'created'"/>
                            <field name="order_date" readonly="state == 'created'"/>
                            <field name="currency_id" required="1" readonly="state == 'created'"/>
                            <field name="total_amount" readonly="1"/>
                        </group>
                    </group>

                    <group string="Extracted Information" invisible="not extracted_by_ai">
                        <group>
                            <field name="vendor_name_raw" readonly="1"/>
                            <field name="vendor_email_raw" readonly="1"/>
                        </group>
                        <group>
                            <field name="vendor_vat_raw" readonly="1"/>
                            <field name="ai_provider_used" readonly="1" invisible="not ai_provider_used"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Line Review" name="lines">
                            <field name="line_ids" readonly="state == 'created'">
                                <list editable="bottom" decoration-warning="not product_id">
                                    <field name="sequence" widget="handle"/>
                                    <field name="source_code"/>
                                    <field name="source_description"/>
                                    <field name="product_id" options="{'no_create': True}"/>
                                    <field name="match_status" widget="badge" readonly="1"/>
                                    <field name="match_candidates" optional="hide" readonly="1"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal" sum="Total" readonly="1"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>

                        <page string="Exceptions" name="exceptions" invisible="not extracted_by_ai">
                            <p class="text-muted">
                                <strong>Block</strong> exceptions require a resolution and acknowledgement before RFQ creation.
                                <strong>Warning</strong> exceptions are informational and never block RFQ creation.
                            </p>
                            <field name="exception_ids" nolabel="1">
                                <list editable="bottom" create="false" delete="false" decoration-danger="exception_type == 'block' and not acknowledged" decoration-warning="exception_type == 'warning'" decoration-success="acknowledged">
                                    <field name="exception_type" widget="badge" readonly="1"/>
                                    <field name="title" readonly="1"/>
                                    <field name="message" readonly="1"/>
                                    <field name="resolution" readonly="exception_type != 'block' or acknowledged"/>
                                    <field name="acknowledged" widget="boolean_toggle" readonly="1"/>
                                    <field name="acknowledged_by" optional="hide" readonly="1"/>
                                    <field name="acknowledged_at" optional="hide" readonly="1"/>
                                    <button name="action_acknowledge"
                                            type="object"
                                            string="Acknowledge"
                                            class="btn-link"
                                            invisible="exception_type != 'block' or acknowledged"/>
                                </list>
                            </field>
                        </page>

                        <page string="Notes">
                            <group>
                                <group>
                                    <field name="notes" placeholder="Commercial notes copied to the RFQ if supported." readonly="state == 'created'"/>
                                </group>
                                <group>
                                    <field name="extraction_summary" placeholder="Extraction warnings and uncertainties" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Technical" groups="base.group_system">
                            <group>
                                <group>
                                    <field name="ai_model_used" readonly="1"/>
                                    <field name="ai_last_analyzed_at" readonly="1"/>
                                </group>
                                <group>
                                    <field name="source_checksum" readonly="1"/>
                                    <field name="ai_payload" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_ai_purchase_intake" model="ir.actions.act_window">
        <field name="name">Document Previews</field>
        <field name="res_model">ai.purchase.intake</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_ai_purchase_intake_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <div class="o_view_nocontent_smiling_face"/>
            <h2>Ready for a clean supplier-document workflow</h2>
            <p>Create a preview, upload a supplier PDF, image, XLSX, or CSV file, run the analysis, review the extracted data, and then create a draft RFQ.</p>
        </field>
    </record>

    <record id="view_purchase_document_upload_wizard_form" model="ir.ui.view">
        <field name="name">purchase.document.upload.wizard.form</field>
        <field name="model">purchase.document.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload Purchase Documents" class="pdi_upload_wizard">
                <sheet>
                    <div class="pdi_upload_panel">
                        <div class="pdi_kicker">Bulk Intake</div>
                        <h2>Upload multiple supplier documents</h2>
                        <p class="text-muted">
                            Add PDF, image, Excel, or CSV documents. Files are queued automatically and processed in upload order: first uploaded, first processed.
                        </p>
                        <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                    </div>
                </sheet>
                <footer>
                    <button name="action_enqueue_documents" type="object" string="Upload &amp; Start Processing" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_purchase_document_upload_wizard" model="ir.actions.act_window">
        <field name="name">Upload Documents</field>
        <field name="res_model">purchase.document.upload.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_purchase_document_upload_wizard_form"/>
        <field name="target">new</field>
    </record>

    <record id="action_purchase_document_queue" model="ir.actions.act_window">
        <field name="name">Processing Queue</field>
        <field name="res_model">ai.purchase.intake</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_ai_purchase_intake_search"/>
        <field name="domain">[("state", "in", ["queued", "processing", "error"])]</field>
        <field name="context">{"search_default_group_state": 1}</field>
        <field name="help" type="html">
            <div class="o_view_nocontent_smiling_face"/>
            <h2>The processing queue is clear</h2>
            <p>Use Upload Documents to add multiple supplier files. Processing starts automatically in FIFO order and completed documents move to Waiting Review.</p>
        </field>
    </record>

</odoo>
