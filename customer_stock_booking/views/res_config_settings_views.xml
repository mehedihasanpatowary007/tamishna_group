<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_customer_stock_booking" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.customer.stock.booking</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Customer Booking" name="customer_stock_booking"
                     groups="base.group_system">
                    <block title="Reminder &amp; Expiry">
                        <setting string="Reminder Lead Time"
                                 help="Send one reminder before the booking expiry date/time. Set Days Before Expiry to 0 to disable reminders.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="customer_booking_reminder_days" class="col-lg-4 o_light_label" string="Days Before Expiry"/>
                                    <field name="customer_booking_reminder_days" class="oe_inline"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_customer_stock_booking_settings" model="ir.actions.act_window">
        <field name="name">Customer Booking Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'customer_stock_booking', 'bin_size': False}</field>
    </record>

    <menuitem id="menu_customer_stock_booking_configuration" name="Configuration"
              parent="customer_stock_booking.menu_customer_stock_booking_root" sequence="90"
              groups="base.group_system"/>
    <menuitem id="menu_customer_stock_booking_settings" name="Settings"
              parent="menu_customer_stock_booking_configuration"
              action="action_customer_stock_booking_settings" sequence="10"
              groups="base.group_system"/>
</odoo>
