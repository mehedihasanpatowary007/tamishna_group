<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_customer_stock_booking_list" model="ir.ui.view">
        <field name="name">customer.stock.booking.list</field>
        <field name="model">customer.stock.booking</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'active'" decoration-muted="state in ['cancelled', 'expired', 'rejected']">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="warehouse_id"/>
                <field name="expiry_datetime"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_customer_stock_booking_search" model="ir.ui.view">
        <field name="name">customer.stock.booking.search</field>
        <field name="model">customer.stock.booking</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="warehouse_id"/>
                <filter name="active_booking" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="open_booking" string="Open" domain="[('state', 'in', ['draft','submitted','sales_approved','active'])]"/>
                <filter name="expired_booking" string="Expired" domain="[('state', '=', 'expired')]"/>
                <group>
                    <filter string="Customer" name="group_customer" context="{'group_by': 'partner_id'}"/>
                    <filter string="Warehouse" name="group_warehouse" context="{'group_by': 'warehouse_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_customer_stock_booking_form" model="ir.ui.view">
        <field name="name">customer.stock.booking.form</field>
        <field name="model">customer.stock.booking</field>
        <field name="arch" type="xml">
            <form string="Customer Stock Booking">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_sales_approve" type="object" string="Sales Approve" class="btn-primary"
                            groups="customer_stock_booking.group_booking_sales_admin" invisible="state != 'submitted'"/>
                    <button name="action_inventory_approve" type="object" string="Inventory Approve &amp; Reserve" class="btn-primary"
                            groups="customer_stock_booking.group_booking_inventory_admin" invisible="state != 'sales_approved'"/>
                    <button name="action_reject" type="object" string="Reject"
                            groups="customer_stock_booking.group_booking_sales_admin,customer_stock_booking.group_booking_inventory_admin"
                            invisible="state not in ['submitted','sales_approved']"/>
                    <button name="action_cancel" type="object" string="Cancel" confirm="Cancel this booking and release remaining reserved stock?"
                            invisible="state in ['cancelled','expired','rejected','fully_delivered']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,sales_approved,active,fully_delivered,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="company_id" readonly="state != 'draft'" groups="base.group_multi_company"/>
                            <field name="warehouse_id" readonly="state != 'draft'"/>
                            <field name="expiry_datetime" readonly="state not in ['draft','submitted','sales_approved']"/>
                        </group>
                        <group>
                            <field name="sales_approved_by" invisible="not sales_approved_by"/>
                            <field name="sales_approved_at" invisible="not sales_approved_at"/>
                            <field name="inventory_approved_by" invisible="not inventory_approved_by"/>
                            <field name="inventory_approved_at" invisible="not inventory_approved_at"/>
                        </group>
                    </group>
                    <group>
                        <field name="purpose" readonly="state != 'draft'" placeholder="Reason / purpose for this customer booking..."/>
                    </group>
                    <field name="show_tracking" invisible="1"/>
                    <notebook>
                        <page string="Booked Products">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="booking_state" column_invisible="True"/>
                                    <field name="company_id" column_invisible="True"/>
                                    <field name="product_id"/>
                                    <field name="tracking" column_invisible="True"/>
                                    <field name="lot_id" string="Lot / Serial" column_invisible="not parent.show_tracking"/>
                                    <field name="reserved_qty"/>
                                    <field name="delivered_qty" readonly="1"/>
                                    <field name="remaining_qty" readonly="1"/>
                                    <field name="free_to_use_qty" readonly="1"/>
                                    <field name="uom_id" readonly="1"/>
                                    <button name="action_open_delivery_wizard" type="object" string="Deliver"
                                            icon="fa-check-square-o"
                                            invisible="booking_state != 'active' or remaining_qty &lt;= 0"/>
                                </list>
                            </field>
                        </page>
                        <page string="Stock Allocation" invisible="state != 'active' and not allocation_ids">
                            <field name="allocation_ids" readonly="1">
                                <list create="false" delete="false" edit="false">
                                    <field name="product_id"/>
                                    <field name="location_id"/>
                                    <field name="lot_id" optional="show"/>
                                    <field name="reserved_qty"/>
                                    <field name="uom_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Delivery History" invisible="not delivery_history_ids">
                            <field name="delivery_history_ids" readonly="1">
                                <list create="false" delete="false" edit="false">
                                    <field name="validated_at"/>
                                    <field name="product_id"/>
                                    <field name="delivery_qty"/>
                                    <field name="uom_id"/>
                                    <field name="validated_by"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_customer_stock_booking" model="ir.actions.act_window">
        <field name="name">Customer Bookings</field>
        <field name="res_model">customer.stock.booking</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_customer_stock_booking_search"/>
        <field name="context">{'search_default_open_booking': 1}</field>
    </record>

    <menuitem id="menu_customer_stock_booking_root" name="Customer Booking" sequence="25"
              web_icon="customer_stock_booking,static/description/icon.png"
              groups="customer_stock_booking.group_booking_user,base.group_system"/>
    <menuitem id="menu_customer_stock_booking" name="Bookings" parent="menu_customer_stock_booking_root"
              action="action_customer_stock_booking" sequence="10"
              groups="customer_stock_booking.group_booking_user"/>
</odoo>
