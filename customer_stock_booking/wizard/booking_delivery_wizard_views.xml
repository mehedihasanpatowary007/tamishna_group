<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_customer_stock_booking_delivery_wizard_form" model="ir.ui.view">
        <field name="name">customer.stock.booking.delivery.wizard.form</field>
        <field name="model">customer.stock.booking.delivery.wizard</field>
        <field name="arch" type="xml">
            <form string="Validate Delivered Quantity">
                <group>
                    <field name="booking_line_id" invisible="1"/>
                    <field name="product_id"/>
                    <field name="remaining_qty"/>
                    <field name="uom_id"/>
                    <field name="quantity"/>
                </group>
                <footer>
                    <button name="action_validate" type="object" string="Validate" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
