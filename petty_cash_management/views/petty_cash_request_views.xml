<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_petty_cash_transaction_kanban" model="ir.ui.view">
        <field name="name">petty.cash.transaction.kanban</field>
        <field name="model">petty.cash.transaction</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" records_draggable="false" quick_create="false" group_create="false" group_edit="false" group_delete="false">
                <field name="state"/><field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <field name="name" class="fw-bold"/>
                            <field name="state" widget="badge"/>
                        </div>
                        <div class="fs-3 fw-bold mb-2"><field name="amount" widget="monetary"/></div>
                        <div class="mb-2"><field name="description"/></div>
                        <div class="text-muted mb-1" groups="base.group_multi_company"><field name="company_id"/></div>
                        <div class="text-muted"><field name="fund_id"/> · <field name="transaction_type"/></div>
                        <div class="d-flex justify-content-between mt-3">
                            <field name="requested_by_id" widget="many2one_avatar_user"/>
                            <field name="date"/>
                        </div>
                        <div class="mt-3" t-if="['finance', 'manager', 'approved'].includes(record.state.raw_value)" groups="account.group_account_manager">
                            <button name="action_approve" type="object" class="btn btn-primary btn-sm">Approve &amp; Post</button>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="action_petty_cash_my_requests" model="ir.actions.act_window">
        <field name="name">My Requests</field>
        <field name="res_model">petty.cash.transaction</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('create_uid', '=', uid)]</field>
        <field name="search_view_id" ref="view_petty_cash_transaction_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first petty cash request</p>
            <p>Choose a fund, enter the amount and attach your receipt. Submit it for approval.</p>
        </field>
    </record>
</odoo>
