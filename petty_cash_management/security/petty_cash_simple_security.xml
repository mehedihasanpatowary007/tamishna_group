<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_request_owner" model="ir.rule">
        <field name="name">request owner</field>
        <field name="model_id" ref="model_petty_cash_transaction"/>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>
    <record id="rule_request_admin" model="ir.rule">
        <field name="name">request admin</field>
        <field name="model_id" ref="model_petty_cash_transaction"/>
        <field name="groups" eval="[Command.link(ref('account.group_account_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
