<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_petty_cash" model="ir.module.category">
        <field name="name">Petty Cash</field>
        <field name="description">Petty cash operations, approvals, accounting, and reporting.</field>
        <field name="sequence">35</field>
    </record>

    <record id="privilege_petty_cash_custodian" model="res.groups.privilege">
        <field name="name">Petty Cash Custodian</field>
        <field name="category_id" ref="module_category_petty_cash"/>
        <field name="sequence">10</field>
    </record>
    <record id="privilege_petty_cash_department_manager" model="res.groups.privilege">
        <field name="name">Petty Cash Department Approval</field>
        <field name="category_id" ref="module_category_petty_cash"/>
        <field name="sequence">20</field>
    </record>
    <record id="privilege_petty_cash_accountant" model="res.groups.privilege">
        <field name="name">Petty Cash Accounting</field>
        <field name="category_id" ref="module_category_petty_cash"/>
        <field name="sequence">30</field>
    </record>
    <record id="privilege_petty_cash_finance" model="res.groups.privilege">
        <field name="name">Petty Cash Finance Management</field>
        <field name="category_id" ref="module_category_petty_cash"/>
        <field name="sequence">40</field>
    </record>
    <record id="privilege_petty_cash_management" model="res.groups.privilege">
        <field name="name">Petty Cash Management Reporting</field>
        <field name="category_id" ref="module_category_petty_cash"/>
        <field name="sequence">50</field>
    </record>

    <record id="group_petty_cash_custodian" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_petty_cash_custodian"/>
    </record>
    <record id="group_petty_cash_department_manager" model="res.groups">
        <field name="name">Approver</field>
        <field name="privilege_id" ref="privilege_petty_cash_department_manager"/>
    </record>
    <record id="group_petty_cash_accountant" model="res.groups">
        <field name="name">Accountant</field>
        <field name="privilege_id" ref="privilege_petty_cash_accountant"/>
        <field name="implied_ids" eval="[Command.link(ref('account.group_account_user'))]"/>
    </record>
    <record id="group_petty_cash_finance_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_petty_cash_finance"/>
        <field name="implied_ids" eval="[Command.link(ref('group_petty_cash_accountant')), Command.link(ref('group_petty_cash_department_manager'))]"/>
    </record>
    <record id="group_petty_cash_management" model="res.groups">
        <field name="name">Viewer</field>
        <field name="privilege_id" ref="privilege_petty_cash_management"/>
    </record>

    <record id="rule_petty_cash_fund_company" model="ir.rule">
        <field name="name">Petty cash funds by allowed company</field>
        <field name="model_id" ref="model_petty_cash_fund"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_petty_cash_period_company" model="ir.rule">
        <field name="name">Petty cash periods by allowed company</field>
        <field name="model_id" ref="model_petty_cash_period"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_petty_cash_transaction_company" model="ir.rule">
        <field name="name">Petty cash transactions by allowed company</field>
        <field name="model_id" ref="model_petty_cash_transaction"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_petty_cash_category_company" model="ir.rule">
        <field name="name">Petty cash categories by allowed company</field>
        <field name="model_id" ref="model_petty_cash_category"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_petty_cash_dashboard_company" model="ir.rule">
        <field name="name">Petty cash dashboard by allowed company</field>
        <field name="model_id" ref="model_petty_cash_dashboard"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_petty_cash_fund_custodian" model="ir.rule">
        <field name="name">Custodians see assigned funds</field>
        <field name="model_id" ref="model_petty_cash_fund"/>
        <field name="groups" eval="[Command.link(ref('group_petty_cash_custodian'))]"/>
        <field name="domain_force">[('custodian_id', '=', user.id)]</field>
    </record>
    <record id="rule_petty_cash_period_custodian" model="ir.rule">
        <field name="name">Custodians see periods for assigned funds</field>
        <field name="model_id" ref="model_petty_cash_period"/>
        <field name="groups" eval="[Command.link(ref('group_petty_cash_custodian'))]"/>
        <field name="domain_force">[('fund_id.custodian_id', '=', user.id)]</field>
    </record>
    <record id="rule_petty_cash_transaction_custodian" model="ir.rule">
        <field name="name">Custodians see transactions for assigned funds</field>
        <field name="model_id" ref="model_petty_cash_transaction"/>
        <field name="groups" eval="[Command.link(ref('group_petty_cash_custodian'))]"/>
        <field name="domain_force">[('custodian_id', '=', user.id)]</field>
    </record>

    <record id="rule_petty_cash_fund_approvers" model="ir.rule">
        <field name="name">Approvers see company funds</field>
        <field name="model_id" ref="model_petty_cash_fund"/>
        <field name="groups" eval="[Command.link(ref('group_petty_cash_department_manager')), Command.link(ref('group_petty_cash_accountant'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_petty_cash_period_approvers" model="ir.rule">
        <field name="name">Approvers see company periods</field>
        <field name="model_id" ref="model_petty_cash_period"/>
        <field name="groups" eval="[Command.link(ref('group_petty_cash_department_manager')), Command.link(ref('group_petty_cash_accountant'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_petty_cash_transaction_approvers" model="ir.rule">
        <field name="name">Approvers see company transactions</field>
        <field name="model_id" ref="model_petty_cash_transaction"/>
        <field name="groups" eval="[Command.link(ref('group_petty_cash_department_manager')), Command.link(ref('group_petty_cash_accountant'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_petty_cash_fund_management" model="ir.rule">
        <field name="name">Management sees company funds</field>
        <field name="model_id" ref="model_petty_cash_fund"/>
        <field name="groups" eval="[Command.link(ref('group_petty_cash_management'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_petty_cash_period_management" model="ir.rule">
        <field name="name">Management sees company periods</field>
        <field name="model_id" ref="model_petty_cash_period"/>
        <field name="groups" eval="[Command.link(ref('group_petty_cash_management'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_petty_cash_transaction_management" model="ir.rule">
        <field name="name">Management sees company transactions</field>
        <field name="model_id" ref="model_petty_cash_transaction"/>
        <field name="groups" eval="[Command.link(ref('group_petty_cash_management'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
