<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         Contra Transfer - List
         ============================================================ -->
    <record id="view_contra_transfer_list" model="ir.ui.view">
        <field name="name">contra.transfer.list</field>
        <field name="model">contra.transfer</field>
        <field name="arch" type="xml">
            <list string="Contra Transfers"
                  default_order="date desc, id desc"
                  decoration-warning="state == 'in_transit'"
                  decoration-success="state == 'completed'"
                  decoration-muted="state in ('cancelled', 'reversed')">
                <field name="date"/>
                <field name="name" string="Transfer No."/>
                <field name="source_journal_id" string="From"/>
                <field name="destination_journal_id" string="To"/>
                <field name="amount" sum="Total Transfer"/>
                <field name="bank_charge" sum="Total Charges" optional="show"/>
                <field name="total_outflow" sum="Total Outflow" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="reference" optional="show"/>
                <field name="age_days" string="Days In Transit" optional="hide"/>
                <field name="approved_by_id" optional="hide"/>
                <field name="state" string="Status" widget="badge"
                       decoration-info="state == 'submitted'"
                       decoration-primary="state == 'approved'"
                       decoration-warning="state == 'in_transit'"
                       decoration-success="state == 'completed'"
                       decoration-danger="state == 'reversed'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============================================================
         Contra Transfer - Form
         Native Odoo layout; accounting internals are manager-only.
         ============================================================ -->
    <record id="view_contra_transfer_form" model="ir.ui.view">
        <field name="name">contra.transfer.form</field>
        <field name="model">contra.transfer</field>
        <field name="arch" type="xml">
            <form string="Contra Transfer">
                <header>
                    <button name="action_submit" type="object" string="Confirm"
                            class="btn-primary" data-hotkey="c"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" data-hotkey="a"
                            groups="account.group_account_manager"
                            invisible="state != 'submitted'"/>
                    <button name="action_mark_sent" type="object" string="Mark as Sent"
                            class="btn-primary"
                            invisible="state != 'approved'"/>
                    <button name="action_mark_received" type="object" string="Mark as Received"
                            class="btn-primary"
                            invisible="state != 'in_transit'"/>
                    <button name="action_reverse" type="object" string="Reverse"
                            class="btn-secondary"
                            groups="account.group_account_manager"
                            invisible="state not in ('in_transit', 'completed')"
                            confirm="This will create compensating bank transactions. Continue?"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'submitted', 'approved')"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,in_transit,completed"/>
                </header>

                <sheet>
                    <!-- Standard smart buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_source_transaction" type="object"
                                class="oe_stat_button" icon="fa-arrow-circle-up"
                                invisible="not source_statement_line_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Source</span>
                                <span class="o_stat_text">Transaction</span>
                            </div>
                        </button>
                        <button name="action_view_destination_transaction" type="object"
                                class="oe_stat_button" icon="fa-arrow-circle-down"
                                invisible="not destination_statement_line_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Destination</span>
                                <span class="o_stat_text">Transaction</span>
                            </div>
                        </button>
                        <button name="action_view_charge_transaction" type="object"
                                class="oe_stat_button" icon="fa-money"
                                invisible="not bank_charge_statement_line_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Bank</span>
                                <span class="o_stat_text">Charge</span>
                            </div>
                        </button>
                        <button name="action_view_reversals" type="object"
                                class="oe_stat_button" icon="fa-undo"
                                invisible="not reversal_statement_line_ids">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Reversal</span>
                                <span class="o_stat_text">Transactions</span>
                            </div>
                        </button>
                    </div>

                    <!-- Standard Odoo ribbons -->
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-secondary"
                            invisible="state != 'cancelled'"/>
                    <widget name="web_ribbon" title="Reversed" bg_color="text-bg-danger"
                            invisible="state != 'reversed'"/>

                    <!-- Title -->
                    <div class="oe_title">
                        <label for="name" string="Contra Transfer"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <!-- Context banners -->
                    <div class="alert alert-warning d-flex align-items-center gap-2"
                         role="alert" invisible="state != 'in_transit'">
                        <i class="fa fa-clock-o" title="In Transit"/>
                        <div>
                            Transfer has left the source journal and is waiting to be received.
                            <span class="ms-1" invisible="age_days &lt;= 0">
                                <strong><field name="age_days" class="oe_inline"/></strong> day(s) in transit.
                            </span>
                        </div>
                    </div>
                    <div class="alert alert-success d-flex align-items-center gap-2"
                         role="alert" invisible="state != 'completed'">
                        <i class="fa fa-check-circle" title="Completed"/>
                        <div>Transfer completed and the internal transfer lines have been reconciled.</div>
                    </div>

                    <!-- Main business fields -->
                    <group>
                        <group string="Transfer Details">
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="source_journal_id" string="From Journal"
                                   readonly="state != 'draft'"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="destination_journal_id" string="To Journal"
                                   readonly="state != 'draft'"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="reference" placeholder="Bank reference / cheque / BEFTN / NPSB reference"
                                   readonly="state not in ('draft', 'submitted')"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                        </group>

                        <group string="Amount">
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="bank_charge" readonly="state != 'draft'"/>
                            <field name="bank_charge_account_id"
                                   readonly="state != 'draft'"
                                   invisible="bank_charge &lt;= 0"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="total_outflow" readonly="1" class="fw-bold"/>
                            <field name="currency_id" readonly="1" options="{'no_open': True}"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Notes &amp; Documents" name="notes_documents">
                            <group>
                                <field name="remarks"
                                       placeholder="Purpose of transfer, payment instruction, cheque details, or other notes..."
                                       readonly="state in ('completed', 'reversed')"/>
                                <field name="attachment_ids" string="Supporting Documents"
                                       widget="many2many_binary"/>
                            </group>
                        </page>

                        <page string="Approval History" name="approval_history">
                            <group>
                                <group string="Submission &amp; Approval">
                                    <field name="submitted_by_id" readonly="1"/>
                                    <field name="submitted_date" readonly="1"/>
                                    <field name="approved_by_id" readonly="1"/>
                                    <field name="approved_date" readonly="1"/>
                                </group>
                                <group string="Transfer Execution">
                                    <field name="sent_by_id" readonly="1"/>
                                    <field name="sent_date" readonly="1"/>
                                    <field name="received_by_id" readonly="1"/>
                                    <field name="received_date" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Accounting" name="accounting"
                              groups="account.group_account_manager">
                            <group>
                                <group string="Ledger Mapping">
                                    <field name="source_account_id" string="From Ledger" readonly="1"/>
                                    <field name="destination_account_id" string="To Ledger" readonly="1"/>
                                    <field name="transfer_account_id" string="Transfer Clearing Account" readonly="1"/>
                                </group>
                                <group string="Posted Transactions">
                                    <field name="source_statement_line_id" readonly="1"/>
                                    <field name="destination_statement_line_id" readonly="1"/>
                                    <field name="bank_charge_statement_line_id" readonly="1"/>
                                </group>
                            </group>
                            <separator string="Journal Entries"/>
                            <group>
                                <group>
                                    <field name="source_move_id" readonly="1"/>
                                    <field name="destination_move_id" readonly="1"/>
                                    <field name="bank_charge_move_id" readonly="1"/>
                                </group>
                                <group>
                                    <field name="reversal_statement_line_ids" readonly="1" widget="many2many_tags"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================
         Search / Reporting
         ============================================================ -->
    <record id="view_contra_transfer_search" model="ir.ui.view">
        <field name="name">contra.transfer.search</field>
        <field name="model">contra.transfer</field>
        <field name="arch" type="xml">
            <search string="Contra Transfers">
                <field name="name"/>
                <field name="reference"/>
                <field name="source_journal_id"/>
                <field name="destination_journal_id"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="pending_approval" string="Pending Approval" domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="in_transit" string="In Transit" domain="[('state', '=', 'in_transit')]"/>
                <filter name="completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <filter name="reversed" string="Reversed" domain="[('state', '=', 'reversed')]"/>
                <separator/>
                <filter name="with_charge" string="With Bank Charge" domain="[('bank_charge', '&gt;', 0)]"/>
                <filter name="today" string="Today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_source" string="From Journal" context="{'group_by': 'source_journal_id'}"/>
                    <filter name="group_destination" string="To Journal" context="{'group_by': 'destination_journal_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_contra_transfer_pivot" model="ir.ui.view">
        <field name="name">contra.transfer.pivot</field>
        <field name="model">contra.transfer</field>
        <field name="arch" type="xml">
            <pivot string="Contra Transfer Analysis">
                <field name="source_journal_id" type="row"/>
                <field name="destination_journal_id" type="row"/>
                <field name="date" type="col" interval="month"/>
                <field name="amount" type="measure"/>
                <field name="bank_charge" type="measure"/>
                <field name="total_outflow" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_contra_transfer_graph" model="ir.ui.view">
        <field name="name">contra.transfer.graph</field>
        <field name="model">contra.transfer</field>
        <field name="arch" type="xml">
            <graph string="Contra Transfer Analysis" type="bar">
                <field name="date" interval="month"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ============================================================
         Actions / Menus
         ============================================================ -->
    <record id="action_contra_transfer" model="ir.actions.act_window">
        <field name="name">Contra Transfers</field>
        <field name="res_model">contra.transfer</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_contra_transfer_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first contra transfer</p>
            <p>Move funds between your own Bank/Cash journals with approval, audit trail and reconciliation control.</p>
        </field>
    </record>

    <record id="action_contra_transfer_in_transit" model="ir.actions.act_window">
        <field name="name">In-Transit Transfers</field>
        <field name="res_model">contra.transfer</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'in_transit')]</field>
        <field name="search_view_id" ref="view_contra_transfer_search"/>
    </record>

    <record id="action_contra_transfer_bank_charge" model="ir.actions.act_window">
        <field name="name">Bank Charges</field>
        <field name="res_model">contra.transfer</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="domain">[('bank_charge', '&gt;', 0)]</field>
        <field name="search_view_id" ref="view_contra_transfer_search"/>
    </record>

    <record id="action_contra_transfer_analysis" model="ir.actions.act_window">
        <field name="name">Transfer Analysis</field>
        <field name="res_model">contra.transfer</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('state', 'in', ('in_transit', 'completed', 'reversed'))]</field>
        <field name="search_view_id" ref="view_contra_transfer_search"/>
    </record>

    <menuitem id="menu_contra_transfer_root" name="Contra Transfers" sequence="45"
              groups="account.group_account_user"
              web_icon="zencore_contra_transfer,static/description/icon.png"/>
    <menuitem id="menu_contra_transfer_operations" name="Operations"
              parent="menu_contra_transfer_root" sequence="10"/>
    <menuitem id="menu_contra_transfer_all" name="Transfer Register"
              parent="menu_contra_transfer_operations" action="action_contra_transfer" sequence="10"/>
    <menuitem id="menu_contra_transfer_in_transit" name="In Transit"
              parent="menu_contra_transfer_operations" action="action_contra_transfer_in_transit" sequence="20"/>
    <menuitem id="menu_contra_transfer_reports" name="Reporting"
              parent="menu_contra_transfer_root" sequence="20"/>
    <menuitem id="menu_contra_transfer_analysis" name="Transfer Analysis"
              parent="menu_contra_transfer_reports" action="action_contra_transfer_analysis" sequence="10"/>
    <menuitem id="menu_contra_transfer_bank_charge" name="Bank Charges"
              parent="menu_contra_transfer_reports" action="action_contra_transfer_bank_charge" sequence="20"/>
</odoo>
